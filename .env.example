# ============================================================
# ROJAK DRIVEK1T — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
# CARA PAKAI:
# 1. Copy file ini jadi .env.local (untuk dev lokal)
#    cp .env.example .env.local
# 2. Isi value yang benar di .env.local
# 3. JANGAN commit .env.local ke Git!
# 4. Untuk production, isi di Vercel Dashboard →
#    Settings → Environment Variables
# ============================================================

# ------------------------------------------------------------
# AI — OPENROUTER
# ------------------------------------------------------------
# Dapatkan API key dari https://openrouter.ai/keys
# Format: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model default (opsional, ada default di kode)
# Contoh: openrouter/free, google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=openrouter/free

# Site URL untuk OpenRouter tracking header (opsional)
SITE_URL=https://drivekit-rojak.vercel.app